# Fine-grained GitHub token (no permissions needed) to raise rate limits
GITHUB_TOKEN=
# Public URL of your deployment, e.g. https://trick-or-commit.vercel.app
NEXT_PUBLIC_SITE_URL=
# Set to 1 to run offline with mock GitHub data and a mock pet
MOCK=

# Optional: "Include my private repos". All four are needed, or the option stays hidden.
# From your GitHub App settings page
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_SLUG=
# Encrypts the session cookie. Generate with: openssl rand -base64 32
SESSION_SECRET=
